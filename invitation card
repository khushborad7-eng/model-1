<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Farewell Party Invitation Card</title>
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Pacifico&family=Poppins:wght@400;600&display=swap');

    body {
      margin: 0;
      padding: 0;
      font-family: 'Poppins', Arial, sans-serif;
      min-height: 100vh;
      background: linear-gradient(120deg, #110052 0%, #fcb0ff 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow-x: hidden;
      position: relative;
    }

    /* Star Animations */
    .star {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }
    .sparkle {
      position: absolute;
      width: 2.4em;
      height: 2.4em;
      opacity: .27;
      filter: blur(2px) brightness(2.1);
      animation: twinkle 7s infinite linear alternate;
    }
    .sparkle1 { left:12vw; top:10vh; animation-delay:0s;}
    .sparkle2 { right:18vw; top:8vh; animation-delay:3.5s;}
    .sparkle3 { left:40vw; top:44vh; animation-delay:1.2s;}
    .sparkle4 { left:80vw; top:28vh; animation-delay:2.4s;}
    .sparkle5 { right:8vw; top:62vh; animation-delay:1.7s;}

    @keyframes twinkle {
      from { opacity: 0.16; transform: scale(1);}
      40% { opacity: 0.9; transform: scale(1.3);}
      to   { opacity: 0.2; transform: scale(0.7);}
    }

    .farewell-card-container {
      perspective: 1200px;
      width: 370px;
      max-width: 95vw;
    }

    .farewell-card {
      position: relative;
      background: linear-gradient(140deg, rgba(255,255,255,0.17) 60%, #fcf0ffcc 100%);
      border-radius: 36px 36px 24px 24px / 44px 44px 16px 16px;
      box-shadow: 0 14px 66px 0 #d441bc27, 0 1.5px 8px #46e3c74d, 0 2px 70px #fff4c4;
      overflow: visible;
      padding: 2.7rem 2rem 2.7rem 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      transform-style: preserve-3d;
      animation: card-party-float 5.5s infinite alternate cubic-bezier(0.57,0.32,0.49,0.95);
      border: 3.5px dashed #ed33d1aa;
    }
    .farewell-card:hover {
      transform: scale(1.04) rotateY(-9deg) rotateX(4deg) translateY(-8px);
      box-shadow: 0 20px 60px 0 #f4aaff77, 0 4px 18px #ffd3fa;
      transition: 0.4s cubic-bezier(.42, -.25, .18, .97);
      cursor: pointer;
    }
    @keyframes card-party-float {
      0%   { transform: translateY(0) rotateX(-1deg) rotateY(0deg);}
      45%  { transform: translateY(-14px) rotateY(-6deg) rotateX(2deg);}
      100% { transform: translateY(-2px)  rotateX(3deg) rotateY(2deg);}
    }

    .party-hat {
      position: absolute;
      top: -47px;
      left: 50%;
      transform: translateX(-50%) rotate(-8deg);
      width: 88px;
      height: 63px;
      z-index: 3;
      pointer-events: none;
    }
    /* Party Hat SVG breathing */
    .party-hat svg {
      animation: hat-bounce 1.7s infinite cubic-bezier(.62,0,0.52,1.47);
      filter: drop-shadow(0px 2px 9px #ffe7fa88);
    }
    @keyframes hat-bounce {
      0% { transform: translateY(0);}
      45% { transform: translateY(-10px);}
      100% { transform: translateY(0);}
    }

    .farewell-avatar {
      width: 86px;
      height: 86px;
      background: linear-gradient(135deg, #ffdde6 10%, #b688fe 80%, #fff0 100%);
      border-radius: 50%;
      border: 6px double #e44fffda;
      box-shadow: 0 4px 24px #ecc1fd66, 0 0 0 15px #fff7f917;
      margin-bottom: 0.65em;
      z-index: 2;
      animation: avatar-spin 7s linear infinite alternate-reverse;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .farewell-avatar img {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      object-fit: cover;
      box-shadow: 0px 0px 18px #e266fd66;
      border: 2px solid #fff;
    }
    @keyframes avatar-spin {
      0% { transform: rotate(-3deg);}
      50% {transform: rotate(9deg);}
      100% { transform: rotate(-3deg);}
    }

    .farewell-title {
      color: #c12888;
      font-family: 'Pacifico', cursive, sans-serif;
      font-size: 2.1em;
      margin: 0.1em 0 0.22em 0;
      font-weight: 600;
      letter-spacing: 1.8px;
      text-shadow: 0 2px 24px #fff0fd88, 0 3.5px 0 #ffdafc55;
      z-index: 2;
      text-align: center;
      line-height: 1.15;
      background: linear-gradient(90deg, #cf4af7 25%, #f778ba 65%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .farewell-date {
      color: #fff;
      background: linear-gradient(90deg,#ffaeea 30%, #eedcff 100%);
      border-radius: 12px;
      padding: 3px 18px;
      margin-bottom: 0.7em;
      font-size: 1.03em;
      font-weight: 500;
      box-shadow:0 1.5px 8px #f45bb35a;
      letter-spacing: 1.1px;
    }

    .farewell-subtitle {
      color: #ae22a8;
      margin-top: 0.25em;
      font-size: 1.22em;
      opacity: 0.94;
      text-transform: uppercase;
      letter-spacing: 1.7px;
      z-index: 2;
      text-align: center;
      font-weight: 700;
      background: linear-gradient(87deg, #fa65e5 40%, #22b9e6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      padding-bottom: 0.5em;
    }

    .farewell-description {
      color: #793191;
      margin: 1.1em 0 1.1em 0;
      font-size: 1.09em;
      line-height: 1.63;
      text-align: center;
      z-index: 2;
      max-width: 99%;
      opacity: 0.98;
      background: rgba(247,255,255,0.13);
      border-radius: 13px;
      padding: 12px 15px 16px 15px;
      font-family: 'Poppins', sans-serif;
    }

    .rsvp-btn {
      background: linear-gradient(105deg,#e90499 10%, #0ecffe 90%);
      color: #fff;
      border: none;
      outline: none;
      border-radius: 24px;
      padding: 13px 40px;
      font-weight: 700;
      letter-spacing: 2.2px;
      font-size: 1.17em;
      cursor: pointer;
      box-shadow: 0 2.6px 12px #d77ffc25, 0 2.5px 10px #b065ea11;
      transition: background 0.45s, box-shadow 0.38s, transform 0.24s;
      position: relative;
      z-index: 2;
      margin-top: 18px;
      text-transform: uppercase;
      overflow: hidden;
      isolation: isolate;
      border-bottom: 3.5px solid #f9a2e0a2;
    }
    .rsvp-btn::after {
      content: '';
      position: absolute;
      z-index: -1;
      left: 50%;
      top: 50%;
      transform: translate(-50%,-50%) scale(0);
      width: 140%;
      height: 225%;
      background: radial-gradient(circle, #fff6fdc5 0%, #6ae3ff 100%);
      opacity: 0.59;
      transition: transform 0.37s cubic-bezier(.91,-0.19,.37,1.22);
      border-radius: 44%;
      pointer-events: none;
    }
    .rsvp-btn:hover::after {
      transform: translate(-50%,-50%) scale(1.08);
    }
    .rsvp-btn:hover {
      transform: translateY(-6px) scale(1.07) rotate(-2deg);
      box-shadow: 0 10px 28px #d225dc58, 0 1.5px 12px #ffcffa;
      background: linear-gradient(107deg,#a93bfc 23%, #ff5ab7 90%);
    }

    /* Balloon Animations */
    .balloon {
      position: absolute;
      z-index: 20;
      width: 44px;
      opacity: .87;
      pointer-events: none;
      animation: balloon-float 8.5s linear infinite;
      filter: drop-shadow(0px 11px 8px #ffc7fc66);
    }
    .balloon1 { left:6%; bottom:18%; animation-delay:0s;}
    .balloon2 { right:10%; bottom:10%; animation-delay:3.9s;}
    .balloon3 { left:26%; bottom:5%; animation-delay:2s;}
    .balloon4 { right:13%; bottom:22%; animation-delay:6.1s;}
    @keyframes balloon-float {
      0% { transform: translateY(0);}
      55% { transform: translateY(-42px) scale(1.05);}
      70% { transform: translateY(-56px) scale(1.1);}
      100% { transform: translateY(-32px);}
    }

    /* Responsive Queries */
    @media (max-width: 540px) {
      .farewell-card-container { width: 99vw; }
      .farewell-card { padding: 1.45rem 2vw 1.4rem 2vw; }
      .farewell-avatar { width:64px;height:64px;}
      .party-hat { width: 58px; height: 42px; }
      .farewell-title { font-size: 1.36em; }
    }
    @media (max-width: 370px) {
      .farewell-description { font-size: 0.85em; }
      .farewell-card { padding: 1.1rem 1vw; }
      .farewell-title { font-size: 1.1em;}
    }

    /* Map Styles */
    .venue-map-container {
      width: 94%;
      display: flex;
      justify-content: center;
      margin-top: 22px;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 1.5px 7px #bfeed425;
      background: rgba(255,246,255,0.33);
    }
    .venue-map-iframe {
      border: 0;
      width: 98%;
      height: 158px;
      min-height: 120px;
      border-radius: 16px;
    }
    @media (max-width: 520px) {
      .venue-map-iframe {
        height: 100px;
      }
    }
  </style>
</head>
<body>
  <!-- Animated Stars -->
  <div class="star">
    <svg class="sparkle sparkle1" viewBox="0 0 24 24" fill="#fff"><polygon points="12 2 14.85 8.46 22 9.27 16 14.14 17.4 21.02 12 17.77 6.6 21.02 8 14.14 2 9.27 9.15 8.46 12 2"/></svg>
    <svg class="sparkle sparkle2" viewBox="0 0 24 24" fill="#ffeeff"><circle cx="12" cy="12" r="8"/></svg>
    <svg class="sparkle sparkle3" viewBox="0 0 24 24" fill="#fd43af"><polygon points="12 5 14 12 21 14 15 17 16 21 12 18 8 21 9 17 3 14 10.2 12 12 5" /></svg>
    <svg class="sparkle sparkle4" viewBox="0 0 24 24" fill="#78ffeb"><rect width="8" height="8" x="8" y="8" rx="2"/></svg>
    <svg class="sparkle sparkle5" viewBox="0 0 24 24" fill="#fff"><polygon points="12 2 14.85 8.46 22 9.27 16 14.14 17.4 21.02 12 17.77 6.6 21.02 8 14.14 2 9.27 9.15 8.46 12 2"/></svg>
  </div>

  <!-- Animated Balloons -->
  <div class="balloon balloon1">
    <svg width="44" height="60" viewBox="0 0 44 60"><ellipse cx="22" cy="28" rx="19" ry="25" fill="#ff97ca"/><rect x="20" y="52" width="4" height="10" rx="2" fill="#aaa"/><path d="M22 52 Q19 59 14 58" stroke="#aaa" stroke-width="1.4" fill="none"/><path d="M22 52 Q27 59 31 58" stroke="#aaa" stroke-width="1.4" fill="none"/></svg>
  </div>
  <div class="balloon balloon2">
    <svg width="44" height="60" viewBox="0 0 44 60"><ellipse cx="22" cy="28" rx="18" ry="23" fill="#45eaff"/><rect x="20" y="52" width="4" height="10" rx="2" fill="#7ab"/><path d="M22 52 Q17 61 8 59" stroke="#699" stroke-width="1.2" fill="none"/><path d="M22 52 Q29 59 38 58" stroke="#699" stroke-width="1.2" fill="none"/></svg>
  </div>
  <div class="balloon balloon3">
    <svg width="44" height="60" viewBox="0 0 44 60"><ellipse cx="22" cy="25" rx="15" ry="19" fill="#ffe55e"/><rect x="20" y="40" width="4" height="10" rx="2" fill="#a76"/><path d="M22 50 Q20 60 10 58" stroke="#a76" stroke-width="1.2" fill="none"/><path d="M22 50 Q28 60 37 58" stroke="#a76" stroke-width="1.2" fill="none"/></svg>
  </div>
  <div class="balloon balloon4">
    <svg width="44" height="60" viewBox="0 0 44 60"><ellipse cx="22" cy="29" rx="16" ry="22" fill="#bb7dfb"/><rect x="20" y="49" width="4" height="10" rx="2" fill="#8be"/><path d="M22 57 Q27 65 40 57" stroke="#8be" stroke-width="1.1" fill="none"/></svg>
  </div>

  <div class="farewell-card-container">
    <div class="farewell-card">
      <!-- Party Hat with animated SVG -->
      <div class="party-hat">
        <svg viewBox="0 0 130 92" width="88" height="63" xmlns="http://www.w3.org/2000/svg">
          <polygon points="65,2 122,90 8,90" fill="url(#hatGradient)" stroke="#7a10d2" stroke-width="3"/>
          <ellipse cx="65" cy="10" rx="12" ry="9" fill="#f6a1ff" opacity=".55"/>
          <circle cx="65" cy="2" r="9" fill="#ffdbfd" stroke="#7a10d2" stroke-width="2"/>
          <circle cx="20" cy="77" r="6.5" fill="#ffd687" />
          <circle cx="110" cy="80" r="6.5" fill="#95ffeb" />
          <defs>
            <linearGradient id="hatGradient" x1="0%" y1="0%" x2="100%" y2="120%">
              <stop offset="0%" stop-color="#e081fe"/>
              <stop offset="36%" stop-color="#49ffd7"/>
              <stop offset="99%" stop-color="#ffd4f7"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
      <!-- Avatar/Image -->
      <div class="farewell-avatar">
        <img src="https://randomuser.me/api/portraits/men/85.jpg" alt="Host">
      </div>
      <div class="farewell-title">Farewell Party 2024</div>
      <div class="farewell-date">10th May 2024 &nbsp; | &nbsp; 6:00 PM</div>
      <div class="farewell-subtitle">Silver Oak University</div>
      <div class="farewell-description">
        <b>You're Invited!</b><br>
        Join us for an evening of laughter, memories, and celebration as we bid a joyful <span style="color:#d824a6;font-weight:600;">farewell</span> to our beloved seniors.<br><br>
        Dress up, bring your brightest smile, and let's make it an unforgettable evening filled with music, heartfelt speeches, and friends forever.<br><br>
        <em class="glow" style="color:#8e19ff;font-weight:600;">Venue: Central Auditorium</em>
        <br>
        <span style="font-size:0.93em; color:#ee35a6;">Special Performances & Refreshments Included!</span>
      </div>
      <button class="rsvp-btn" onclick="window.open('mailto:farewell-rsvp@silveroak.edu','_blank')">RSVP Now</button>
      <!-- Map embed for venue location -->
      <div class="venue-map-container">
        <iframe
          class="venue-map-iframe"
          src="https://www.openstreetmap.org/export/embed.html?bbox=72.6392%2C23.2156%2C72.6757%2C23.2373&amp;layer=mapnik"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <div style="margin-top: 1rem;text-align:center;font-size:0.91em; color:#a677efb6;">Let the new journey begin with a night to remember. <span style="color:#ff96dd;font-weight:600;">Don't miss it!</span></div>
    </div>
  </div>
</body>
</html>

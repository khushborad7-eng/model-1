<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Gray Layout & Floating Box Animation</title>
  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      background:#ffffff;
      display:flex;x    
      flex-direction:column;
      align-items:center;
      min-height:100vh;
      font-family:Arial, sans-serif;
    }

    .container{
      width:350px;
      padding:8px;
      margin-top:30px;
    }

    .gray-box{
      background:#777171;
      border-radius:2px;
      display:flex;
      justify-content:center;
      align-items:center;
    }

    .box-label{
      color: rgb(22, 19, 19);
      font-size: 20px;
      font-weight: bold;
      font-family: inherit;
    }

    .top{
      height:50px;
      margin-bottom:12px;
    }

    .middle{
      display:flex;
      gap:10px;
      margin-bottom:15px;
    }

    .left{
      flex:2;
      height:80px;
    }

    .right{
      flex:1;
      display:flex;
      flex-direction:column;
      gap:7px;
    }

    .small{
      height:20px;
    }

    .bottom{
      height:55px;
    }

    .floating-box-animation-container {
      width: 100vw;
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 40px;
      margin-bottom: 40px;
    }

    .floatbox {
      width:120px;
      height:120px;
      background:linear-gradient(135deg,#ff0066,#6a00ff);
      border-radius:20px;
      animation:
        float 3s ease-in-out infinite,
        rotate 4s linear infinite;
      box-shadow:0 15px 30px rgba(0,0,0,0.2);
    }

    @keyframes float{
      0%{
        transform:translateY(0px);
      }
      50%{
        transform:translateY(-40px);
      }
      100%{
        transform:translateY(0px);
      }
    }

    @keyframes rotate{
      0%{
        rotate:0deg;
      }
      100%{
        rotate:360deg;
      }
    }
 
    .floating-box {
      display: none;
    }

    @media(max-width:768px){
      .container{
        width:95%;
      }
      .middle{
        flex-direction:column;
      }
      .left{
        height:40px;
      }
      .floating-box-animation-container {
        margin-top: 24px;
        margin-bottom: 24px;
      }
    }
  </style>
</head>

<body>

  <div class="container">
    <div class="gray-box top"><span class="box-label">Box 1</span></div>
    <div class="middle">
      <div class="gray-box left"><span class="box-label">Box 2</span></div>
      <div class="right">
        <div class="gray-box small"><span class="box-label">Box 3</span></div>
        <div class="gray-box small"><span class="box-label">Box 4</span></div>
        <div class="gray-box small"><span class="box-label">Box 5</span></div>
      </div>
    </div>
    <div class="gray-box bottom"><span class="box-label">Box 6</span></div>
  </div>

  <div class="floating-box-animation-container">
    <div class="floatbox"></div>
  </div>
</body>
</html>

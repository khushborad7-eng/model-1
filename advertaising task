      font-weight:900;
      animation: bounceIn 0.85s;
    }
    .slide-btn:active, .slide-btn:focus{outline:none;}
    .slide-btn:hover{
      background:#ffe44d;
      color:#ed6a1a;
      opacity:1;
      box-shadow:0 10px 18px #ffe44dad,0 4px 10px #ffe44d48;

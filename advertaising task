      z-index:100;
    }
    .unique-wave{
      position:absolute;
      bottom:-60px;
      left:-60px;
      width:700px;
      height:180px;
      z-index:1;
      pointer-events: none;
      opacity:0.20;
      filter: blur(2px) hue-rotate(22deg);
      animation: waveShift 7s infinite linear;
    }
    @keyframes waveShift {
      from{transform:translateX(0);}
      to{transform:translateX(120px);}
    }
    .ad-footer{
      text-align:center;
      margin-top:28px;
      font-size:23px;
      font-weight:700;
      color:#431c77;
      animation: fadeInUp 1.1s;
      letter-spacing:.03em;
      border-radius:13px;
      background:linear-gradient(97deg,#fffde9 55%,#e7e7fd 100%);
      padding-top:16px;
      padding-bottom:12px;
      box-shadow:0 2px 11px #471b7d13;
    }
    .ad-footer strong{
      color:#ec7e3e;
      letter-spacing:.08em;
      font-weight:900;
      filter: drop-shadow(0px 1.8px 7px #e8b7999a);
      animation: pulseBox 2.2s infinite alternate;
    }
    .call-btn{
      background:linear-gradient(90deg,#ffd61c 70%,#ffc223 100%);
      color:#392500;
      font-weight:800;
      border-radius:18px;
      padding:13px 39px;
      font-size:23px;
      transition: filter .2s,box-shadow .2s;
      margin:15px auto 0px auto;
      display:block;
      outline:0;
      border:none;
      box-shadow: 0 3px 21px rgba(255,220,60,.15);
      animation: bubbleanimBtn 2.2s infinite alternate;
      cursor:pointer;
      letter-spacing:.03em;
      border-bottom:3.7px solid #f8bf2c80;
    }
    @keyframes bubbleanimBtn {
      0%{transform:scale(1);}
      60%{transform:scale(1.06);}
      100%{transform:scale(1);}
    }
    .call-btn:hover {
      filter: brightness(1.19) saturate(1.1);
      box-shadow:0 10px 28px #ffe44dad,0 4px 11px #ffd788b8;
      color:#291c00;
      animation:none;
    }

    @media(max-width:900px){
      .ad-container{max-width:99vw;}
      .slide{flex-direction:column; align-items:center; gap:16px;}
      .poster-main{width:100%;}
      .slide-img-human{margin-bottom:13px; width:130px;}
      .fees-bubble{right:20px;top:108px;font-size:24px;}
      .slide-title{font-size:32px;}
      .slide-box{font-size:17px;}
      .small-banner{font-size:16px; padding:7px 19px;}
    }
    @media(max-width:600px){
      .ad-container{padding:7px;border-radius:14px;}
      .poster-slider{border-radius:11px;}
      .features{flex-direction:column;gap:8px;}
      .slide-img-human{width:90px;}
      .fees-bubble{display:none;}
      .slide-title{font-size:15px;}
      .slide-box{font-size:11.5px;padding:5px 9px;}
      .date-box{font-size:13px; width:105px;}
      .call-btn{font-size:15px; padding:9px 13px;}
      .ad-footer{font-size:13px;}
    }
    /* Additional sparkles over slider */
    .sparkle {
      position: absolute;
      width: 18px;
      height: 18px;
      pointer-events: none;
      z-index: 20;
      background: radial-gradient(circle,#fff7e9 0%, #fff5c6aa 90%, transparent 100%);
      border-radius:50%;
      opacity:.85;
      animation: sparkle-anim 1.6s infinite linear;
    }
    @keyframes sparkle-anim {
      0%{opacity:.2; transform:scale(.3) translateY(0);}
      25%{opacity:.8; transform:scale(.65) translateY(-6px);}
      50%{opacity:1;  transform:scale(1) translateY(4px);}
      75%{opacity:.7;}
      100%{opacity:.2; transform:scale(.3) translateY(0);}
    }
  </style>
</head>

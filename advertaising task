      border:5px solid #fff8cd;
      background:#fff;
      margin-left:8px;
      margin-right:8px;
      animation: imgFloat 2.4s infinite alternate, hueFloat 9s infinite linear;
      transition: box-shadow .25s;
    }
    .slide-img-human:hover{
      box-shadow: 0 7px 57px 0 #ffebe9, 0 7px 27px #f1eaff91;
      filter:brightness(1.07) saturate(1.3);
    }
    @keyframes imgFloat {
      from{transform:translateY(0);}
      to{transform:translateY(-20px);}
    }
    @keyframes hueFloat {
      0% {filter: hue-rotate(0deg);}
      100% {filter: hue-rotate(-13deg);}
    }

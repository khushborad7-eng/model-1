  <script>
    // Banner Slider Logic
    const slides = document.getElementById('posterSlides');
    const totalSlides = slides.children.length;
    let current = 0;

    // Animation: fade slides
    function animateSlideShow(prevIdx, newIdx) {
      const allSlides = slides.children;
      for (let i = 0; i < allSlides.length; i++) {
        allSlides[i].style.opacity = i === newIdx ? "1" : "0.68";
        allSlides[i].style.transition = i === newIdx ? "opacity 0.33s cubic-bezier(.5,1.6,.51,1.04)" : "opacity 0.2s";
      }
    }

    function updateSlider(prev=current){
      slides.style.transform = `translateX(-${current * 100}%)`;
      animateSlideShow(prev, current);
    }
    document.getElementById('slidePrev').addEventListener('click',function(){
      let prev = current;
      current = (current-1+totalSlides)%totalSlides;
      updateSlider(prev);
      manualSliderReset();
    });
    document.getElementById('slideNext').addEventListener('click',function(){
      let prev = current;
      current = (current+1)%totalSlides;
      updateSlider(prev);
      manualSliderReset();
    });

    // Autoplay: 1s interval
    let autoSlide = setInterval(()=>{
      let prev = current;
      current = (current+1)%totalSlides;
      updateSlider(prev);
    }, 1000);

    // Pause/Resume on hover
    slides.addEventListener('mouseenter', () => clearInterval(autoSlide));
    slides.addEventListener('mouseleave', () => {
      autoSlide = setInterval(()=>{
        let prev = current;
        current = (current+1)%totalSlides;
        updateSlider(prev);
      }, 1000);
    });

    // Reset interval timer if button click
    function manualSliderReset() {
      clearInterval(autoSlide);
      autoSlide = setInterval(()=>{
        let prev = current;
        current = (current+1)%totalSlides;
        updateSlider(prev);
      }, 1000);
    }

    // Initial slide animation:
    animateSlideShow(0, 0);

    // Sparkle Animation for more wow!
    function genSparkle(x, y, id){
      const sp = document.createElement("div");
      sp.className = "sparkle";
      sp.style.left = `${x}px`;
      sp.style.top = `${y}px`;
      sp.style.animationDelay = Math.random()*1.4 + "s";
      sp.id = "spk"+id+Math.floor(Math.random()*10000);
      return sp;
    }
    // Attach sparkles randomly to poster-slider
    function randomSparkle() {
      const box = document.getElementById('sliderMain');
      const w = box.offsetWidth, h = box.offsetHeight;
      const sparkleBox = document.getElementById('sparkle-box');
      sparkleBox.innerHTML = "";
      for(let i=0; i<7; i++) {
        let x = Math.random()*(w-18);
        let y = Math.random()*(h-38) + 10;
        sparkleBox.appendChild(genSparkle(x,y,i));
      }
    }
    setTimeout(randomSparkle,650);
    window.addEventListener('resize',()=>setTimeout(randomSparkle, 330));
    // sparkle update every few seconds
    setInterval(randomSparkle,1400);
  </script>
</body>
</html>

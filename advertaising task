    body{
      background: linear-gradient(132deg,#a8edea 0%, #fed6e3 100%);
      min-height:100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow-x: hidden;
      animation: rainbowBG 12s linear infinite alternate;
    }

    @keyframes rainbowBG {
      0% { filter: hue-rotate(0deg);}
      100% { filter: hue-rotate(60deg);}
    }

    .ad-container{
      position:relative;
      width: 98vw;
      max-width: 880px;
      margin: 42px auto;
      padding:28px 18px 28px 18px;
      border-radius:32px;
      box-shadow: 0 14px 48px 0 rgba(60,40,60,.16), 0 1.2px 6px rgba(80,30,150,0.11);
      background: rgba(255,255,255,0.99);
      overflow:hidden;
      z-index:3;
      border:2.5px solid #ec4317cc;
      animation: ad-pop .9s cubic-bezier(.8, -.1, .71, 1.22);
    }
    @keyframes ad-pop {
      0% {transform: scale(.85);}
      80% {transform: scale(1.07);}
      100% {transform: scale(1);}
    }

    .advert-line{
      font-size: 22px;
      font-weight: 900;
      letter-spacing: 0.08em;
      color: #e36519;
      background: linear-gradient(93deg, #ffe76f 50%,#fff9de 90%);
      text-align: center;
      border-radius: 10px;
      padding: 11px 0;
      margin-bottom: 18px;
      box-shadow:0 2px 18px 0 #ffe37255;
      border: 2.5px dashed #fde56d;
      animation: fadeInUp 1.1s, slideWave 4.2s infinite alternate ease-in-out;
    }
    @keyframes slideWave {
      0% {transform: translateX(-6px);}
      100% {transform: translateX(9px);}
    }
    .poster-slider{
      width:100%;
      margin-bottom:38px;
      border-radius:24px;
      box-shadow:0 7px 21px rgba(20,9,41,0.15);
      overflow:hidden;
      position:relative;
      background:#e7fff5;
      /* Neumorphism effect: */
      border: 1.3px solid #fee7ff;
      animation: sliderWobble 6s infinite alternate;
    }
    @keyframes sliderWobble {
      0% {box-shadow:0 7px 21px #130f4136;}
      100%{box-shadow:0 13px 27px #f891ffa6, 0 7px 21px #fbe3ff48;}
    }
    .slides{
      display:flex;
      transition:transform 0.53s cubic-bezier(.8,1.96,.65,1.1);
      min-width:100%;
    }
    .slide{
      min-width:100%;
      box-sizing:border-box;
      padding:34px 18px 48px 18px;
      flex-shrink:0;
      display: flex;
      gap: 32px;
      align-items: flex-start;
      position:relative;
      background: linear-gradient(100deg,#e9fff5 68%,#f9dfff 100%);
      animation: bgfadeSlide 10s infinite alternate;
      opacity:0.92;
    }
    @keyframes bgfadeSlide {
      0%   {background:linear-gradient(99deg,#e9fff5 66%,#f5dfff 100%);}
      25%  {background:linear-gradient(113deg,#f6ffed 62%,#fff7e1 100%);}
      52%  {background:linear-gradient(134deg,#e9f7fc 54%,#f9fed8 100%);}
      75%  {background:linear-gradient(114deg,#f7f5fd 82%,#fffddb 100%);}
      100% {background:linear-gradient(105deg,#e9fff5 66%,#f9dfff 100%);}
    }
    .poster-main{
      flex:2;
      min-width:250px;
      z-index:2;
      animation: posterFadeIn .6s;
    }
    @keyframes posterFadeIn {
      0% {opacity:0; transform:scale(.92);}
      100%{opacity:1; transform:scale(1);}
    }
    .slide-title{
      font-size: 54px;
      font-weight: 900;
      background: linear-gradient(93deg,#914bfd,#b67323,#35ab53 85%);
      background-clip:text;
      -webkit-background-clip:text;
      color:transparent;
      -webkit-text-fill-color:transparent;
      letter-spacing: -1.5px;
      margin-bottom:8px;
      line-height:1.09;
      animation: pulseTitle 1.08s infinite alternate;
    }
    @keyframes pulseTitle {
      0% {letter-spacing:-2px; filter:brightness(1);}
      100%{letter-spacing:2px; filter:brightness(1.17);}
    }
    .glow-grammer {
      display:inline-block;
      padding: 6px 22px;
      margin: 16px 0 22px 0;
      background: linear-gradient(90deg,#ffe968 15%,#fffdea 90%);
      border-radius: 11px;
      font-size: 24px;
      font-weight: 900;
      color: #8b650d;
      box-shadow: 0 3px 14px 0 #ffeb3b1b;
      text-shadow: 0 0 14px #fff9d19e, 0 2px 3px #ffe59d35;
      letter-spacing: .12em;
      animation: grammeranim 2.1s infinite alternate, hue-grammer 5s infinite linear;
    }
    @keyframes grammeranim {
      0% {box-shadow:0 2px 11px 0 #fff4abf5;}
      100%{box-shadow:0 8px 22px 0 #fff7e280;}
    }
    @keyframes hue-grammer{
      from{filter: hue-rotate(0deg);}
      to{filter: hue-rotate(20deg);}
    }
    .small-banner{
      background:#261940;
      color:#fff;
      display:inline-block;
      padding:8px 26px 7px 26px;
      margin:8px 0 10px 0;
      font-weight:700;
      font-size:22px;
      border-radius:10px;
      letter-spacing:0.10em;
      animation: fadeInUp 1.07s;
      box-shadow:0 1.5px 18px #cb57f255;
      border:2px solid #b073ff27;
    }
    @keyframes fadeInUp {
      0%{opacity:0; transform:translateY(54px);}
      100%{opacity:1; transform:translateY(0);}
    }
    .slide-box{
      background: linear-gradient(107deg, #fd6184 20%, #e6a426 83%);
      color:#fff;
      padding:13px 27px;
      border-radius:14px;
      margin-bottom:22px;
      margin-top:14px;
      width: auto;
      display:inline-block;
      font-size:32px;
      font-weight:800;
      letter-spacing:0.09em;
      box-shadow:0 2px 18px rgba(250,47,70,.17);
      border:2px solid #faeff98a;
      animation: bounceIn .95s, pulseBox 3s infinite alternate;
    }
    @keyframes bounceIn{
      0%{transform:scale(0.8);}
      55%{transform:scale(1.14);}
      100%{transform:scale(1);}
    }
    @keyframes pulseBox {
      0% { filter: brightness(1);}
      100%{filter: brightness(1.09);}
    }
    .date-box{
      margin-top:11px;
      background:linear-gradient(112deg,#fffbe6,#e5f7fc);
      padding:17px 11px 15px 11px;
      border-radius:12px;
      font-weight:700;
      font-size:23px;
      color:#333;
      width:230px;
      text-align:center;
      border:2px solid #ffe86d88;
      letter-spacing:0.12em;
      box-shadow:0 2px 12px rgba(78,78,78,.11);
      animation: fadeInUp 1.02s, pulseBox 3.7s infinite alternate;
    }
    .fees-bubble{
      position: absolute;
      right: 36px; top: 88px;
      background: linear-gradient(115deg,#f5e86b 60%,#ffdb29 100%);
      color: #222;
      padding: 20px 39px 20px 25px;
      border-radius: 85px 68px 105px 79px / 56px 88px 75px 68px;
      font-size: 36px;
      font-weight: 900;
      letter-spacing: 0.15em;
      box-shadow: 0 7px 38px rgba(255,222,52,0.21),0 1.5px 6px #fbe0ff62;
      border:4px solid #fcf6b6;
      text-align:center;
      animation: bubbleanim 1.4s infinite alternate, wiggle 6s infinite linear;
      z-index:3;
    }
    @keyframes bubbleanim {
      0%{transform:translateY(0) scale(.92);}
      55%{transform:translateY(-12px) scale(1.09);}
      100%{transform:translateY(0) scale(1);}
    }
    @keyframes wiggle {
      0% {filter: hue-rotate(0deg);}
      100% {filter: hue-rotate(20deg);}
    }
    .slide-img-human{

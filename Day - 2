<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>OJT</title>
  <link rel="stylesheet" href="ojt.css">
  <style>
    body {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
      background: #222;
      overflow-x: hidden;
    }
    #bg-video {
      position: fixed;
      right: 0;
      bottom: 0;
      min-width: 100vw;
      min-height: 100vh;
      width: 100vw;
      height: 100vh;
      z-index: -1;
      background-size: cover;
      object-fit: cover;
      top: 0;
      left: 0;
      pointer-events: none;
    }
    .content {
      position: relative;
      z-index: 2;
      min-height: 100vh;
      backdrop-filter: blur(0.5px);
    }
    nav {
      background-color: #000000;
      padding: 10px;
      text-align: center;
    }
    nav a {
      color: #fff;
      text-decoration: none;
      margin: 0 15px;
      font-weight: bold;
      font-size: 16px;
      transition: color 0.2s;
    }
    nav a:hover {
      color: #ffc107;
    }
  </style>
</head>
<body>

  <video autoplay muted loop playsinline id="bg-video">
    <source src="ojt.mp4" type="video/mp4" />
    
  </video>

  <div class="content">
    <header>
      <nav>
        <a href="#">Home</a>
        <a href="#">Sign up</a>
        <a href="#">Sign In</a>
        <a href="#">About us</a>
        <a href="#">Contact us</a>
      </nav>
    </header>

    <main>
      <section>
        <article>
          <figure style="text-align:center;">
            <img src="C:/Users/khush/OneDrive/Pictures/Screenshots/sil.png" style="height:50px; margin: auto; display: block;">
            <figcaption><mark>Silver Oak University Registration</mark></figcaption>
          </figure>
          <h1 style="text-align:center; color:#333; font-family:Arial, sans-serif;">
            Registration Form <date style="font-size:14px; color:#575555; display:block; margin-top:5px;"><mark>
              <time datetime="2026-05-12">May 12, 2026</time>
            </mark></date>
          </h1>
          <form action="#" method="post" enctype="multipart/form-data" style="max-width:400px; margin:0 auto; padding:20px; padding-bottom:20px; border:1px solid #db0e0e; border-radius:8px; background:#49ecee;">
            <label for="name" style="display:block; margin-bottom:5px; font-weight:bold;">Name: <mark>Required</mark></label>
            <input type="text" id="name" name="name" required style="width:100%; padding:7px; margin-bottom:15px; border:1px solid #999; border-radius:4px;">

            <label for="enrollment" style="display:block; margin-bottom:5px; font-weight:bold;">Enrollment No: <mark>12 digit</mark></label>
            <input type="text" id="enrollment" name="enrollment" maxlength="12" required style="width:100%; padding:7px; margin-bottom:15px; border:1px solid #999; border-radius:4px;">

            <label for="branch" style="display:block; margin-bottom:5px; font-weight:bold;">Branch:</label>
            <select id="branch" name="branch" required style="width:100%; padding:7px; margin-bottom:15px; border:1px solid #999; border-radius:4px;">
              <option value="" disabled selected>--Select Branch--</option>
              <option value="CSE">Computer Science & Engineering</option>
              <option value="IT">Information Technology</option>
              <option value="ME">Mechanical Engineering</option>
              <option value="EC">Electronics & Communication</option>
              <option value="EE">Electrical Engineering</option>
            </select>

            <label for="division" style="display:block; margin-bottom:5px; font-weight:bold;">Division: <mark>One Character</mark></label>
            <input type="text" id="division" name="division" maxlength="1" pattern="[A-Za-z0-9]{1}" title="Single digit or letter" required style="width:100%; padding:7px; margin-bottom:15px; border:1px solid #999; border-radius:4px;">

            <label style="display:block; margin-bottom:5px; font-weight:bold;">Gender:</label>
            <div style="margin-bottom:15px;">
              <input type="radio" id="male" name="gender" value="male" required>
              <label for="male" style="margin-right: 10px;">Male</label>
              <input type="radio" id="female" name="gender" value="female" required>
              <label for="female" style="margin-right: 10px;">Female</label>
              <input type="radio" id="other" name="gender" value="other" required>
              <label for="other" style="margin-right: 10px;">Other</label>
            </div>

            <label for="mobile" style="display:block; margin-bottom:5px; font-weight:bold;">Mobile Number: <mark>10 digit</mark></label>
            <input type="text" id="mobile" name="mobile" pattern="[0-9]{10}" maxlength="10" title="Enter 10 digit mobile number" required style="width:100%; padding:7px; margin-bottom:15px; border:1px solid #999; border-radius:4px;">

            <label for="email" style="display:block; margin-bottom:5px; font-weight:bold;">Email ID:</label>
            <input type="email" id="email" name="email" required style="width:100%; padding:7px; margin-bottom:15px; border:1px solid #999; border-radius:4px;">

            <label for="password" style="display:block; margin-bottom:5px; font-weight:bold;">Password:</label>
            <input type="password" id="password" name="password" required style="width:100%; padding:7px; margin-bottom:15px; border:1px solid #999; border-radius:4px;">

            <label for="dob" style="display:block; margin-bottom:5px; font-weight:bold;">Date of Birth: <date><mark>YYYY-MM-DD</mark></date></label>
            <input type="date" id="dob" name="dob" required style="width:100%; padding:7px; margin-bottom:15px; border:1px solid #999; border-radius:4px;">

            <label for="age" style="display:block; margin-bottom:5px; font-weight:bold;">Age:</label>
            <input type="number" id="age" name="age" min="0" max="150" required style="width:100%; padding:7px; margin-bottom:15px; border:1px solid #999; border-radius:4px;">

            <label for="address" style="display:block; margin-bottom:5px; font-weight:bold;">Address:</label>
            <textarea id="address" name="address" rows="2" cols="30" required style="width:100%; padding:7px; margin-bottom:15px; border:1px solid #999; border-radius:4px;"></textarea>

            <label for="city" style="display:block; margin-bottom:5px; font-weight:bold;">City:</label>
            <input type="text" id="city" name="city" required style="width:100%; padding:7px; margin-bottom:15px; border:1px solid #999; border-radius:4px;">

            <label for="pincode" style="display:block; margin-bottom:5px; font-weight:bold;">Pincode: <mark>6 digit</mark></label>
            <input type="text" id="pincode" name="pincode" pattern="[0-9]{6}" maxlength="6" title="Enter 6 digit pincode" required style="width:100%; padding:7px; margin-bottom:15px; border:1px solid #999; border-radius:4px;">

            <label for="photo" style="display:block; margin-bottom:5px; font-weight:bold;">Photo Upload:</label>
            <figure style="margin:0; margin-bottom:10px;">
              <input type="file" id="photo" name="photo" accept="image/*" required style="margin-bottom:5px;">
              <figcaption><mark>JPG, PNG or GIF</mark></figcaption>
            </figure>

            <label for="remarks" style="display:block; margin-bottom:5px; font-weight:bold;">Remarks:</label>
            <textarea id="remarks" name="remarks" rows="3" cols="30" required style="width:100%; padding:7px; margin-bottom:15px; border:1px solid #999; border-radius:4px;"></textarea>

            <div style="display: flex; gap: 10px;">
              <input type="submit" value="Submit" style="flex:1; padding:10px; background:#007bff; color:#fff; border:none; border-radius:4px; font-size:16px; cursor:pointer;">
              <input type="reset" value="Reset" style="flex:1; padding:10px; background:#6c757d; color:#fff; border:none; border-radius:4px; font-size:16px; cursor:pointer;">
            </div>
          </form>
        </article>
      </section>
    </main>

    <br>
    <footer>
      <p>&copy; <mark>Silver Oak University</mark> <date><time datetime="2024">2024</time></date></p>
    </footer>
  </div>
</body>
</html>


footer {
  background-color: #333;
  color: #fff;
  text-align: center;
  padding: 12px 0;
  position: relative;
  bottom: 0;
  width: 100%;
  font-size: 16px;
}

footer p {
  margin: 0;
  font-weight: 600;
  letter-spacing: 0.5px;
}
html, body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
}

#bg-video {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: -1;
}

.content {
  position: relative;
  z-index: 1;
  color: white;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<style>
    .silveroak {
        background-color: #C0C0C0;
        color: #000000;
        padding: 20px;
        border-radius: 10px;
        margin-left: 37%;
    }
    .silveroak:hover {
        background-color: #000000;
        color: #FFFFFF;
        transform: scale(1.2);
        transition: 1.5s;
    }
    .simple-icons-container {
        text-align: center;
        margin-top: 30px;
    }
    .icon-simple {
        margin: 0 12px;
        font-size: 2.5rem;
        color: #333;
        transition: color 0.5s;
        cursor: pointer;
        vertical-align: middle;
    }
    .icon-simple:hover {
        color: #0078d7;
    }
    .ojt-video-container {
        display: flex;
        justify-content: center;
        margin-top: 30px;
    }
    .ojt-video {
        max-width: 50%;
        border-radius: 12px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.15);
    }
</style>
</head>
<body>

    <img class="silveroak" src="silver.png" alt="sea">

    <div class="ojt-video-container">
        <video class="ojt-video" autoplay loop muted>
            <source src="ojt.mp4" type="video/mp4">
        </video>
    </div>

    <div class="simple-icons-container">
        <a href="https://www.facebook.com" target="_blank" aria-label="Facebook"><i class="fab fa-facebook icon-simple"></i></a>
        <a href="https://www.twitter.com" target="_blank" aria-label="Twitter"><i class="fab fa-twitter icon-simple"></i></a>
        <a href="https://www.instagram.com" target="_blank" aria-label="Instagram"><i class="fab fa-instagram icon-simple"></i></a>
    </div>

</body>
</html>
